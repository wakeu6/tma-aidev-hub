# ==========================================
# YouTube Shorts Pipeline & TMA Configuration
# ==========================================

# 1. Telegram Bot & Branding
TG_BOT_TOKEN="your_bot_token_here"
BRAND_BOT_HANDLE="@YourBot"
ENABLE_BRAND_PILL=true

# 2. Telegram Mini App & Adsgram
WEBAPP_URL="http://localhost:8000"
ADSGRAM_BLOCK_ID="your_adsgram_block_id_here"
DEBUG_MOCK=True

# 3. Content Pipeline & Speech (TTS)
# Модели: eleven_multilingual_v2 или eleven_flash_v2_5
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID=""
ELEVENLABS_MODEL_ID="eleven_multilingual_v2"

# 4. Google Veo & Gemini Video Generation
# При отсутствии ключа или MOCK_VEO=True используется процедурный рендер
VEO_API_KEY=""
GEMINI_API_KEY=""
MOCK_VEO=True

# 5. Database & Proxy (Опционально)
DATABASE_URL="sqlite+aiosqlite:///tma_service/data/tma.db"
HTTP_PROXY=""
